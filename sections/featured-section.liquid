{%- stylesheet -%}
  .featured-block-content {
    display: flex;
    justify-content: space-between;
  }
{%- endstylesheet -%}
<div class="gradient"></div>
<div class="section--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% for block in section.blocks %}
      <div class="featured-block-content" {{ block.shopify_attributes }}style="gap: {{ block.settings.gap }}px;">
        <div class="featured-block-content-info">
          <div class="featured-block-content-info-heading">{{ block.settings.heading }}</div>
          <div class="featured-block-content-info-text">{{ block.settings.text }}</div>
          {% if block.settings.icon != blank %}
            <div class="featured-block-content-info-icon">
              {{ block.settings.icon | raw }}
            </div>
          {% endif %}
          {%- if block.settings.button_link != blank -%}
            <a class="button featured-block-content-info-link" href="{{ block.settings.button_link }}"
              >shop bestsellers</a
            >
          {%- endif -%}
        </div>
        {%- if block.settings.image != blank -%}
          <div class="featured-block-content-image">
            <img
              src="{{ block.settings.image | image_url: width: 590 }}"
              alt="{{ block.settings.image.alt | escape }}"
              style="border-radius: {{ block.settings.image_radius }}px;"
            >
          </div>
        {%- endif -%}
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Featured sectio",
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Featured content block",
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<h2>Quality guarantee</h2>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<h2>Two of our core brand values are quality & trust, which is why everything we do is built on a foundation of excellence & transparency. Our products are -</h2>"
        },
        {
          "type": "textarea",
          "id": "icon",
          "label": "Icon SVG"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Settings"
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Content gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 41
        },
        {
          "type": "range",
          "id": "image_radius",
          "label": "Image border radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured section",
      "settings": {}
    }
  ]
}
{% endschema %}
