{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- stylesheet -%}
  h2,
  p {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
  }
  .featured-block-content {
    display: flex;
    justify-content: space-between;
    @media (max-width: 750px) {
      flex-direction: column;
    }
  }
  .featured-block-content-info-heading > * {
    margin-bottom: 32px;

    font-weight: 600;
    font-size: 62px;
    line-height: 100%;
    letter-spacing: -0.03em;
    color: #43384f;
    text-transform: capitalize;
    @media (max-width: 750px) {
      margin-bottom: 14px;
      font-size: 42px;
    }
  }
  .featured-block-content-info-text > * {
    line-height: 120%;
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .featured-block-content-info-icon {
    margin-top: 30px;
    margin-bottom: 35px;
    @media (max-width: 750px) {
      margin-top: 24px;
      margin-bottom: 24px;
    }
  }
  .featured-block-content-info-icon svg {
    @media (max-width: 750px) {
      max-width: 100%;
    }
  }
  .featured-block-content-image {
    @media (max-width: 750px) {
      margin-top: 24px;
    }
  }
  .featured-block-content-image img {
    @media (max-width: 450px) {
      /* max-height: 360px; */
    }
  }
  .featured-block-content-info-link {
    max-width: 100%;
    width: 353px;
    height: 66px;

    border-radius: 10px !important;
    font-weight: 600 !important;
    font-size: 26px !important;
    line-height: 100% !important;
    letter-spacing: -0.03em !important;
    overflow: hidden;
    @media (max-width: 750px) {
      width: 335px;
      height: 62px;
    }
  }
{%- endstylesheet -%}
<div class="gradient"></div>
<div class="section--{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% for block in section.blocks %}
      <div class="featured-block-content" {{ block.shopify_attributes }}style="gap: {{ block.settings.gap }}px;">
        <div class="featured-block-content-info">
          <div class="featured-block-content-info-heading">{{ block.settings.heading }}</div>
          <div class="featured-block-content-info-text">{{ block.settings.text }}</div>
          {% if block.settings.icon != blank %}
            <div class="featured-block-content-info-icon">
              {{ block.settings.icon | raw }}
            </div>
          {% endif %}
          {%- if block.settings.button_link != blank -%}
            <a class=" button featured-block-content-info-link" href="{{ block.settings.button_link }}"
              >shop bestsellers</a
            >
          {%- endif -%}
        </div>
        {%- if block.settings.image != blank -%}
          <div class="featured-block-content-image">
            <img
              src="{{ block.settings.image | image_url: width: 590 }}"
              alt="{{ block.settings.image.alt | escape }}"
              style="border-radius: {{ block.settings.image_radius }}px;"
            >
          </div>
        {%- endif -%}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    var BREAKPOINT = 750;

    function moveFeaturedImages() {
      var blocks = document.querySelectorAll('.featured-block-content');
      var isMobile = window.innerWidth < BREAKPOINT;

      blocks.forEach(function (block) {
        var imageWrap = block.querySelector('.featured-block-content-image');
        var textBlock = block.querySelector('.featured-block-content-info-text');
        if (!imageWrap || !textBlock) return;

        if (isMobile) {
          textBlock.appendChild(imageWrap);
        } else {
          block.appendChild(imageWrap);
        }
      });
    }

    function onResize() {
      moveFeaturedImages();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', moveFeaturedImages);
    } else {
      moveFeaturedImages();
    }
    window.addEventListener('resize', onResize);
  })();
</script>
{% schema %}
{
  "name": "Featured sectio",
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top ",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Featured content block",
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<h2>Quality guarantee</h2>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<h2>Two of our core brand values are quality & trust, which is why everything we do is built on a foundation of excellence & transparency. Our products are -</h2>"
        },
        {
          "type": "textarea",
          "id": "icon",
          "label": "Icon SVG"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Settings"
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Content gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 41
        },
        {
          "type": "range",
          "id": "image_radius",
          "label": "Image border radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured section",
      "settings": {}
    }
  ]
}
{% endschema %}
